# Copy the five database values from Supabase's Session pooler connection details.
# Keep the password as plain text here; SQLAlchemy URL.create handles escaping.
DB_HOST=aws-0-ap-northeast-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_SCHEMA=stormwatch
DB_USER=postgres.PROJECT_REF
DB_PASSWORD=replace-with-database-password
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
PIPELINE_LOCATION_MAX_ATTEMPTS=3
PIPELINE_RETRY_BACKOFF_SECONDS=5
PIPELINE_INTERVAL_SECONDS=3600
PIPELINE_ADVISORY_LOCK_ID=836986827
STATUS_STALE_AFTER_SECONDS=7200
PROVINCE_API_BASE_URL=https://provinces.open-api.vn/api
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
